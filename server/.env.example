# Groq API Configuration (Recommended: High-Speed Sub-Second Inference)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_MODEL=openai/gpt-oss-120b
ARENA_MODEL_A=openai/gpt-oss-120b
ARENA_MODEL_B=openai/gpt-oss-20b

# Google Gemini API Configuration (Alternative Cloud Backup)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM API Configuration (Enterprise Visual & Code Fallback)
# Get your API key from https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_KEYS=key1,key2

# Server Port
PORT=3001
